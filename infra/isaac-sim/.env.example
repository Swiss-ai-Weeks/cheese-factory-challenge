ISAAC_SIM_IMAGE=nvcr.io/nvidia/isaac-sim:6.1.0@sha256:af1d2b4e75d553bfa27beb5a401198654aa8d607f3b7a6749196e9ce253def20
ISAAC_SIM_DATA=/home/ubuntu/docker/isaac-sim
ISAACSIM_HUB_CACHE_PATH=/home/ubuntu/.cache/ov/hub
GPU_DEVICE=0

# The browser desktop and WebRTC viewer run on the same host as Isaac Sim.
ISAACSIM_HOST=127.0.0.1
ISAACSIM_SIGNAL_PORT=49100
ISAACSIM_STREAM_PORT=47998
WEB_VIEWER_PORT=8210

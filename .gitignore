# ---------------------------------------------------------------------------
# Donnees et poids : trop volumineux pour git, et entierement reconstructibles.
# Tout se regenere avec vault/80 Ops/Reproduce everything.md
# ---------------------------------------------------------------------------

# 14 Go de telechargements bruts
data/raw/

# 947 Mo d'images normalisees + decoupes + rendus convertis
data/processed/

# 4,6 Go de rendus PNG bruts (archive ; les JPEG utiles sont dans data/processed)
sim/out/

# images des demos : ~1 a 7 Go de PNG chacune, dont la video est le seul livrable
sim/render/
sim/rendu_auto/
sim/rendu_bras/
sim/out2/
sim/out_test/

# bancs d'essai jetables ecrits pour isoler un bug, gardes hors depot. Les deux
# qui servent encore sont `sim/banc_automate.py` et `sim/banc_politique.py`.
sim/_essai_*.py

# Checkpoints 350 Mo piece et exports ONNX : au-dela de la limite GitHub de 100 Mo.
# Les results.json sont versionnes, eux : ce sont les mesures.
runs/**/*.pt
runs/**/*.onnx
runs/**/*.onnx.data
# Validation-only Stage 8 candidates are retained locally, never versioned.
runs/sim_bin_stage8_*/
runs/stage8_baselines/

# environnement
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# sorties locales
*.log
outputs/

# Local Isaac Sim host paths and GPU selection
infra/isaac-sim/.env
.env
